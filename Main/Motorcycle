
public class Motorcycle extends Vehicle {

    private String motorcycleStyle;   
    private int    engineCC;          
    private boolean hasSideCar;
    private double mpg;

    public Motorcycle(String make, String model, int year,
                      String fuelType, double dailyRentalRate,
                      int mileage, String lastMaintenanceDate,
                      int maintenanceIntervalMiles, double insurancePricePerDay,
                      String motorcycleStyle, int engineCC,
                      boolean hasSideCar, double mpg) {

        super(make, model, year, fuelType, dailyRentalRate,
              mileage, lastMaintenanceDate,
              maintenanceIntervalMiles, insurancePricePerDay);

        this.motorcycleStyle = motorcycleStyle;
        this.engineCC        = engineCC;
        this.hasSideCar      = hasSideCar;
        this.mpg             = mpg;
    }

    @Override
    public String getVehicleType() { return "Motorcycle"; }

    
    @Override
    public double calculateTotalCost(int days) {
        double base = super.calculateTotalCost(days);
        if (hasSideCar) {
            base += 3.00 * days;
        }
        return base;
    }

    public String  getMotorcycleStyle() { return motorcycleStyle; }
    public int     getEngineCC()        { return engineCC; }
    public boolean hasSideCar()         { return hasSideCar; }
    public double  getMpg()             { return mpg; }

    @Override
    public String toString() {
        return super.toString()
            + String.format(" | Style: %s | Engine: %dcc | MPG: %.1f | Sidecar: %s",
                motorcycleStyle, engineCC, mpg, hasSideCar ? "Yes (+$3/day)" : "No");
    }
}
