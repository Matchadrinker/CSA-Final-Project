
public class Sedan extends Car {

    private boolean hasAdaptiveCruiseControl;
    private String  safetyRating;  

    public Sedan(String make, String model, int year,
                 String fuelType, double dailyRentalRate,
                 int mileage, String lastMaintenanceDate,
                 int maintenanceIntervalMiles, double insurancePricePerDay,
                 double mpg, boolean hasAdaptiveCruiseControl,
                 String safetyRating) {

        super(make, model, year, fuelType, dailyRentalRate,
              mileage, lastMaintenanceDate,
              maintenanceIntervalMiles, insurancePricePerDay,
              5, mpg, 4);

        this.hasAdaptiveCruiseControl = hasAdaptiveCruiseControl;
        this.safetyRating             = safetyRating;
    }

    @Override
    public String getVehicleType() { return "Sedan"; }

    @Override
    public double calculateTotalCost(int days) {
        double base = super.calculateTotalCost(days);
        if (safetyRating != null && safetyRating.startsWith("5")) {
            base -= getInsurancePricePerDay() * 0.05 * days; 
        }
        return base;
    }

    public boolean hasAdaptiveCruiseControl() { return hasAdaptiveCruiseControl; }
    public String  getSafetyRating()          { return safetyRating; }

    @Override
    public String toString() {
        return super.toString()
            + " | Safety: " + safetyRating
            + " | Adaptive Cruise: " + (hasAdaptiveCruiseControl ? "Yes" : "No");
    }
}
